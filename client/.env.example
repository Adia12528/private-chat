# URL of the realtime server (server/ folder) you deployed.
VITE_SOCKET_URL=http://localhost:3001

# WebRTC ICE servers. The default STUN server is free and needs no signup.
# Fill in TURN values only if calls fail on strict/corporate networks later.
VITE_STUN_SERVER=stun:stun.l.google.com:19302
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
