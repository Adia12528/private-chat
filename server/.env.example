PORT=3001

# Comma-separate multiple allowed origins if you need more than one, e.g.:
# CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Private rooms are just ID:PASSWORD pairs (JSON). Anyone who knows an ID +
# password can join that room's group chat and call people inside it.
# Do NOT commit your real ACCOUNTS_JSON to GitHub — set it as an environment
# variable on your hosting platform (Render/Railway/etc.) instead.
ACCOUNTS_JSON={"one":"badmosh"}

# Optional: Metered STUN/TURN integration for WebRTC calls
# METERED_DOMAIN=your-subdomain.metered.live
# METERED_SECRET_KEY=your_secret_key
